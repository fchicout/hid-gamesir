# UDev rules for GameSir Controllers handled by hid-gamesir
# Ensure appropriate permissions for hidraw and controller nodes

# GameSir controller in DS4 emulation mode (Guangzhou Chicken Run)
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", ATTRS{manufacturer}=="Guangzhou Chicken Run*", MODE="0660", TAG+="uaccess"

# Auto-rebind GameSir controllers to hid-gamesir instead of generic hid-playstation
ACTION=="add", SUBSYSTEM=="hid", DRIVERS=="playstation", ATTRS{manufacturer}=="Guangzhou Chicken Run*", RUN+="/bin/sh -c 'echo $kernel > /sys/bus/hid/drivers/playstation/unbind; echo $kernel > /sys/bus/hid/drivers/hid-gamesir/bind'"
